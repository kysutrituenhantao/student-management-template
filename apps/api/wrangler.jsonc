// Local development and tests. Production config is generated at deploy time
// by scripts/prod-config.mjs (adds the real D1 id, static assets, custom domain).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lop-hoc-hanh-phuc",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  // Sign-in attempts per IP per minute, counted per Cloudflare location. Production sets 30 (scripts/prod-config.mjs):
  // a class signing in together from one school network must still get through. namespace_id is any number unique
  // within the Cloudflare account.
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "2001", "simple": { "limit": 1000, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lop-hoc-hanh-phuc",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_URL": "http://localhost:8080"
  }
}
